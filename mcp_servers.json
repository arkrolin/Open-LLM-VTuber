{
  "mcp_servers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=Asia/Shanghai"
      ]
    },
    "ddg-search": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "windows-mcp": {
      "command": "uvx",
      "args": [
        "windows-mcp",
        "--transport",
        "stdio"
      ]
    }
  }
}